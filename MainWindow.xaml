<Window x:Class="SecurityShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Shield" Height="620" Width="940"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#0F1020" FontFamily="Segoe UI">

    <!-- ============ COLOURS AND SHARED STYLES ============ -->
    <!-- Defining colours once here means we can reuse them by name below. -->
    <Window.Resources>
        <SolidColorBrush x:Key="Panel"     Color="#17182B"/>
        <SolidColorBrush x:Key="Track"     Color="#242843"/>
        <SolidColorBrush x:Key="TextLight" Color="#F2F3FB"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9A9CB5"/>
        <SolidColorBrush x:Key="Green"     Color="#39E08A"/>
        <SolidColorBrush x:Key="Blue"      Color="#3EA6FF"/>
        <SolidColorBrush x:Key="Purple"    Color="#8F7BFF"/>
        <SolidColorBrush x:Key="Amber"     Color="#FFC53D"/>

        <!-- The look of the small "Fix" / "Clean" buttons. -->
        <Style x:Key="FixButton" TargetType="Button">
            <Setter Property="Background" Value="#242843"/>
            <Setter Property="Foreground" Value="#CDD0EA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#303655"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Green}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ============ TWO COLUMNS: SIDEBAR + MAIN AREA ============ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#13142A" BorderBrush="#242843" BorderThickness="0,0,1,0">
            <StackPanel Margin="16,18">

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Margin="4,0,0,24">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Blue}"/>
                    <TextBlock Text="Security Shield" Foreground="{StaticResource TextLight}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>

                <!-- Nav items. The active one is highlighted; the rest are placeholders for later slices. -->
                <Border Background="#1F2742" CornerRadius="8" Padding="12,9" Margin="0,0,0,4">
                    <TextBlock Text="Dashboard" Foreground="{StaticResource Blue}" FontSize="13" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="Scan"      Foreground="{StaticResource TextMuted}" FontSize="13" Margin="12,9"/>
                <TextBlock Text="Passwords" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="12,9"/>
                <TextBlock Text="Cleaner"   Foreground="{StaticResource TextMuted}" FontSize="13" Margin="12,9"/>
                <TextBlock Text="Privacy"   Foreground="{StaticResource TextMuted}" FontSize="13" Margin="12,9"/>
                <TextBlock Text="VPN"       Foreground="{StaticResource TextMuted}" FontSize="13" Margin="12,9"/>
                <TextBlock Text="Settings"  Foreground="{StaticResource TextMuted}" FontSize="13" Margin="12,9"/>
            </StackPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1" Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- top bar -->
                <RowDefinition Height="Auto"/>   <!-- hero: score + right panel -->
                <RowDefinition Height="Auto"/>   <!-- metric tiles -->
                <RowDefinition Height="*"/>      <!-- things to fix -->
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Dashboard" Foreground="{StaticResource TextLight}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" Background="#12281E" BorderBrush="#1F5C3F" BorderThickness="1"
                        CornerRadius="999" Padding="12,4">
                    <TextBlock Text="Game mode on" Foreground="{StaticResource Green}" FontSize="12"/>
                </Border>
            </Grid>

            <!-- Hero -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Score ring. The green arc is drawn by the C# code. -->
                <Grid Grid.Column="0" Width="184" Height="184" Margin="0,0,24,0">
                    <Ellipse Width="170" Height="170" Stroke="{StaticResource Track}" StrokeThickness="14"/>
                    <Path x:Name="ScoreArc" Stroke="{StaticResource Green}" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScoreText" Text="87" Foreground="{StaticResource TextLight}" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="/ 100" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                        <TextBlock x:Name="StatusText" Text="Protected" Foreground="{StaticResource Green}" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Right panel -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Good shape" Foreground="{StaticResource TextLight}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Text="Fix 3 things to reach 100" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,2,0,14"/>

                    <!-- Rank + XP -->
                    <Grid Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sentinel" Foreground="{StaticResource Purple}" FontSize="12"/>
                            <TextBlock Text="Level 12" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="XpText" Text="2,840 / 4,000 xp" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" Background="{StaticResource Track}" CornerRadius="999" HorizontalAlignment="Left" Width="300">
                        <Border x:Name="XpFill" Background="{StaticResource Purple}" CornerRadius="999" HorizontalAlignment="Left" Width="213"/>
                    </Border>

                    <!-- Game Ready button -->
                    <Button x:Name="GameReadyButton" Click="GameReady_Click" Cursor="Hand" HorizontalAlignment="Left" Margin="0,16,0,0" Width="300">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource Blue}" CornerRadius="9" Padding="10">
                                    <TextBlock Text="Game ready - optimise now" Foreground="#051226" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Metric tiles -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10" Padding="14,11" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="CPU impact" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock Text="2%" Foreground="{StaticResource Green}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="14,11" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Last scan" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock Text="Clean" Foreground="{StaticResource Green}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="14,11" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Accounts safe" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="AccountsText" Text="4 / 5" Foreground="{StaticResource Amber}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Things to fix -->
            <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="10" Padding="16,6" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Things to fix" Foreground="{StaticResource TextLight}" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,6"/>

                    <!-- Row 1 -->
                    <Border x:Name="Fix1Row" BorderBrush="#262A45" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                            <TextBlock Foreground="#DFE0EE" FontSize="13" VerticalAlignment="Center">
                                <Run Text="Update 2 outdated apps"/><Run Text="   +8 xp" Foreground="#6F7291"/>
                            </TextBlock>
                            <Button x:Name="Fix1Btn" Content="Fix" Style="{StaticResource FixButton}" HorizontalAlignment="Right" Click="Fix1_Click"/>
                        </Grid>
                    </Border>

                    <!-- Row 2 -->
                    <Border x:Name="Fix2Row" BorderBrush="#262A45" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                            <TextBlock Foreground="#DFE0EE" FontSize="13" VerticalAlignment="Center">
                                <Run Text="1 weak password"/><Run Text="   +6 xp" Foreground="#6F7291"/>
                            </TextBlock>
                            <Button x:Name="Fix2Btn" Content="Fix" Style="{StaticResource FixButton}" HorizontalAlignment="Right" Click="Fix2_Click"/>
                        </Grid>
                    </Border>

                    <!-- Row 3 -->
                    <Border x:Name="Fix3Row" Padding="0,10">
                        <Grid>
                            <TextBlock Foreground="#DFE0EE" FontSize="13" VerticalAlignment="Center">
                                <Run Text="Clear 4.2 GB of junk"/><Run Text="   +5 xp" Foreground="#6F7291"/>
                            </TextBlock>
                            <Button x:Name="Fix3Btn" Content="Clean" Style="{StaticResource FixButton}" HorizontalAlignment="Right" Click="Fix3_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
